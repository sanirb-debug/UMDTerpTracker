node_modules
dist
.DS_Store
*.local

# Scratch worktree used by tools/deploy-pages.sh
.deploy-gh-pages

# Never commit a real transcript, redacted or not. A PDF carries metadata that
# redacting the visible text does not remove, and this repository is public.
#
# Every committed fixture is generated by tools/generate-samples.mjs from
# invented data. To test against a real transcript, drop it in one of these
# local-only paths and point the scripts at it — nothing here is tracked.
*.pdf
/local/
/fixtures/local/
*.local.txt
